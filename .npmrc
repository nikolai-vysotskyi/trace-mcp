legacy-peer-deps=true

# Supply-chain quarantine: don't resolve to a freshly published version.
# Compromised-maintainer publishes are typically yanked within days, so a
# waiting period catches them without blocking routine upgrades. Lockfile
# installs (`--frozen-lockfile`, i.e. all of CI) are unaffected — this only
# gates *new* resolutions. Two keys because the two clients spell it
# differently: npm >=11.10 wants days, pnpm wants minutes.
min-release-age=7
minimum-release-age=10080

# TRA-1559: narrow quarantine exception for the verified adm-zip security
# release. v0.6.1 (2026-09-11) fixes CVE-2026-76845 / GHSA-vwc7-r8mq-g2x9
# ("Blocked extraction from writing through symlinks inside the target" in
# the upstream release notes); Dependabot alert #141 has no other patch.
# Pinned to the exact version so future adm-zip publishes still wait out
# the quarantine. Revisit: drop this line once 0.6.1 is older than the
# waiting period above.
minimum-release-age-exclude[]=adm-zip@0.6.1

# TRA-2647: body-parser 2.4.0 fixes GHSA-27r3-jxmh-p828 and is the only
# patched 2.x release. Permit this exact version until it clears seven days.
minimum-release-age-exclude[]=body-parser@2.4.0

# TRA-2647: fast-uri 4.2.3 fixes GHSA-w74x-v6f9-j3xg and
# GHSA-wjr9-j795-jxcr. Permit only this release until it clears seven days.
minimum-release-age-exclude[]=fast-uri@4.2.3
